# ── Backend environment configuration ────────────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# backend/.env is excluded from Git and must NEVER be committed.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./uploads.db

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_TEMP_DIR=./upload_tmp

# ── Google OAuth credentials ──────────────────────────────────────────────────
CREDENTIALS_FILE=credentials.json
TOKEN_FILE=token.json

# ── Phase 2A: AI Content Generation ──────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
RESEARCH_PROVIDER=web

# ── Phase 2B/2C: Text-to-Speech ──────────────────────────────────────────────
TTS_PROVIDER=auto
TTS_DEFAULT_VOICE=en-US-AriaNeural
TTS_LOCAL_VOICE=local-zira
TTS_LOCAL_RATE=165
TTS_OUTPUT_DIR=G:\youtube-uploader\data\audio
TTS_MODEL_DIR=G:\youtube-uploader\data\models\tts
TTS_MAX_TEXT_LENGTH=5000
TTS_TIMEOUT_SECONDS=60

# ── Phase 2D: FFmpeg ──────────────────────────────────────────────────────────
# Download FFmpeg from https://github.com/BtbN/FFmpeg-Builds/releases
# Extract to tools\ffmpeg\bin\ — see README.md § FFmpeg
FFMPEG_PATH=G:\youtube-uploader\tools\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=G:\youtube-uploader\tools\ffmpeg\bin\ffprobe.exe
